###############################################################################
# VlogHub - environment template
#
# Copy to .env and fill in real values:  cp .env.example .env
# Then:  php artisan key:generate
#
# NEVER commit .env. Every value below is a secret in production.
###############################################################################

# --- Application -------------------------------------------------------------
APP_NAME="VlogHub"
APP_ENV=local                   # local | staging | production
APP_KEY=                        # php artisan key:generate
APP_DEBUG=true                  # MUST be false in production
APP_URL=http://localhost/website_vlog
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                 # use "warning" or "error" in production

# --- Database ----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=website_vlog
DB_USERNAME=root
DB_PASSWORD=

# --- Session / cache / queue -------------------------------------------------
# Database drivers work out of the box. Switch to redis in production.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false     # true once the site is on HTTPS
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Filesystem --------------------------------------------------------------
FILESYSTEM_DISK=local
# Run "php artisan storage:link" so uploaded media is reachable.

# --- Mail --------------------------------------------------------------------
# "log" writes emails to storage/logs instead of sending them. Configure real
# SMTP before launch, and set up SPF, DKIM and DMARC for the sending domain.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@vloghub.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- First admin account (used once by AdminSeeder) --------------------------
ADMIN_NAME="Super Admin"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@vloghub.test
ADMIN_PASSWORD=                 # set a strong password before seeding

# --- Video pipeline (optional) ----------------------------------------------
# Without FFmpeg the platform still works: files play progressively, the
# creator supplies the thumbnail, and duration is read in the browser.
# With FFmpeg installed you get duration probing, auto thumbnails and HLS.
FFMPEG_PATH=
FFPROBE_PATH=
VIDEO_MAX_SIZE_KB=524288        # 512 MB; keep below PHP upload_max_filesize
VIDEO_MAX_DURATION=3600

# --- Object storage / CDN (phase 2) -----------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Front end ---------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
